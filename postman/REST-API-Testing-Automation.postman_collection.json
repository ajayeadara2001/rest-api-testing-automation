{
  "info": {"_postman_id": "3ded4d69-d893-4e07-972f-7aa0f1e925be", "name": "REST API Testing & Automation", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Restful Booker API baseline: health, list, create/read, auth, PUT/PATCH, delete and verification. Set username and password in a private Postman environment before running authenticated requests."},
  "variable": [{"key": "baseUrl", "value": "https://restful-booker.herokuapp.com"}],
  "item": [
    {"name": "Health — Ping", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/ping"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 201', function () { pm.response.to.have.status(201); });"]}}]},
    {"name": "Get Booking IDs", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/booking"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "pm.test('Returns an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"]}}]},
    {"name": "Create Booking", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"firstname\": \"QA\",\n  \"lastname\": \"Automation\",\n  \"totalprice\": 350,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2027-01-10\",\n    \"checkout\": \"2027-01-15\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}"}, "url": "{{baseUrl}}/booking"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('Booking ID is returned', function () { pm.expect(body.bookingid).to.be.a('number'); });", "pm.environment.set('bookingId', body.bookingid);"]}}]},
    {"name": "Get Created Booking", "request": {"method": "GET", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{baseUrl}}/booking/{{bookingId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('Created name is returned', function () { pm.expect(body.firstname).to.eql('QA'); pm.expect(body.lastname).to.eql('Automation'); });"]}}]},
    {"name": "Create Token", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"}, "url": "{{baseUrl}}/auth"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.test('Token is returned', function () { pm.expect(body.token).to.be.a('string').and.not.empty; });", "pm.environment.set('token', body.token);"]}}]},
    {"name": "Replace Booking (PUT)", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}, {"key": "Cookie", "value": "token={{token}}"}], "body": {"mode": "raw", "raw": "{\n  \"firstname\": \"QA\",\n  \"lastname\": \"Updated\",\n  \"totalprice\": 600,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2027-02-10\",\n    \"checkout\": \"2027-02-15\"\n  },\n  \"additionalneeds\": \"Lunch\"\n}"}, "url": "{{baseUrl}}/booking/{{bookingId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "pm.test('PUT returns replacement values', function () { const b = pm.response.json(); pm.expect(b.lastname).to.eql('Updated'); pm.expect(b.totalprice).to.eql(600); });"]}}]},
    {"name": "Verify PUT", "request": {"method": "GET", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{baseUrl}}/booking/{{bookingId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "pm.test('PUT persisted', function () { const b = pm.response.json(); pm.expect(b.lastname).to.eql('Updated'); pm.expect(b.totalprice).to.eql(600); });"]}}]},
    {"name": "Partial Update (PATCH)", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}, {"key": "Cookie", "value": "token={{token}}"}], "body": {"mode": "raw", "raw": "{\n  \"firstname\": \"QA-Patch\",\n  \"additionalneeds\": \"Dinner\"\n}"}, "url": "{{baseUrl}}/booking/{{bookingId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "pm.test('PATCH returns changed value', function () { pm.expect(pm.response.json().firstname).to.eql('QA-Patch'); });"]}}]},
    {"name": "Verify PATCH", "request": {"method": "GET", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{baseUrl}}/booking/{{bookingId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "pm.test('PATCH persisted without unintended overwrite', function () { const b = pm.response.json(); pm.expect(b.firstname).to.eql('QA-Patch'); pm.expect(b.lastname).to.eql('Updated'); });"]}}]},
    {"name": "Delete Booking", "request": {"method": "DELETE", "header": [{"key": "Cookie", "value": "token={{token}}"}], "url": "{{baseUrl}}/booking/{{bookingId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 201', function () { pm.response.to.have.status(201); });"]}}]},
    {"name": "Verify Deletion", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/booking/{{bookingId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Deleted booking is not retrievable', function () { pm.response.to.have.status(404); });"]}}]}
  ]
}
